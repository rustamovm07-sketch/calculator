<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="QaziCalculator.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QaziCalculator.Views"
    Title="Mahsulotlar"
    Background="{AppThemeBinding Light={StaticResource PageBackgroundLightBrush}, Dark={StaticResource PageBackgroundDarkBrush}}"
    xmlns:sh="clr-namespace:Sharpnado.MaterialFrame;assembly=Maui.MaterialFrame">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <views:PageNavigationBar />
            <VerticalStackLayout Spacing="4">
                <Label Text="Mahsulotlar" Style="{StaticResource PageTitle}" />
                <Label Text="Faqat siz kiritgan mahsulot va zaxiralar" Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
            <sh:MaterialFrame Style="{StaticResource AppCard}" Padding="16">
                <VerticalStackLayout Spacing="9">
                    <Label Text="Mahsulot qaydi" Style="{StaticResource SectionTitle}" />
                    <Entry x:Name="NameEntry" Placeholder="Mahsulot nomi" />
                    <Entry x:Name="UnitEntry" Placeholder="Birlik (masalan, kg)" />
                    <Entry x:Name="StockEntry" Placeholder="Haqiqiy zaxira miqdori" Keyboard="Numeric" />
                    <Entry x:Name="PriceEntry" Placeholder="Sotuv narxi / birlik (so'm)" Keyboard="Numeric" />
                    <Editor x:Name="NotesEditor" Placeholder="Izoh (ixtiyoriy)" AutoSize="TextChanges" />
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox x:Name="ActiveCheckBox" IsChecked="True" />
                        <Label Text="Faol mahsulot" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Saqlash" Clicked="SaveButton_Clicked" Style="{StaticResource PrimaryActionButton}" />
                        <Button Grid.Column="1" Text="Tozalash" Clicked="ClearButton_Clicked" />
                    </Grid>
                    <Label x:Name="SelectionLabel" Text="Tahrirlash uchun mahsulotni tanlang." Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </sh:MaterialFrame>
            <sh:MaterialFrame Style="{StaticResource AppCard}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Mahsulotlar ro'yxati" Style="{StaticResource SectionTitle}" />
                    <CollectionView x:Name="ProductsCollection" SelectionMode="Single" SelectionChanged="ProductsCollection_SelectionChanged" EmptyView="Mahsulotlar hali qo'shilmagan.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <sh:MaterialFrame Padding="12" Margin="0,0,0,8" Style="{StaticResource GlassSurface}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                                            <Label Text="{Binding IsActive, StringFormat='Faol: {0}'}" Style="{StaticResource SecondaryText}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="End">
                                            <Label Text="{Binding StockQuantity, StringFormat='{0:N2}'}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding Unit}" Style="{StaticResource SecondaryText}" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding SalePrice, StringFormat='{0:N0} UZS'}" FontSize="12" HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </sh:MaterialFrame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="Tanlangan mahsulotni o'chirish" Clicked="DeleteButton_Clicked" BackgroundColor="{AppThemeBinding Light=#F3E7E9, Dark=#34191D}" TextColor="{AppThemeBinding Light=#8B1E2D, Dark=#F0AAB2}" />
                </VerticalStackLayout>
            </sh:MaterialFrame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
