<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="QaziCalculator.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QaziCalculator.Views"
    Title="Statistika"
    Background="{AppThemeBinding Light={StaticResource PageBackgroundLightBrush}, Dark={StaticResource PageBackgroundDarkBrush}}"
    xmlns:sh="clr-namespace:Sharpnado.MaterialFrame;assembly=Maui.MaterialFrame">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <views:PageNavigationBar />
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Statistika"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                <Label
                    Text="Faqat saqlangan real qayta ishlash yozuvlari"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
            </VerticalStackLayout>

            <sh:MaterialFrame
                Padding="14"
                Style="{StaticResource GlassSurface}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Davr"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                    <ScrollView Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="TodayFilterButton" Text="Bugun" Clicked="TodayFilterButton_Clicked" CornerRadius="14" Padding="14,9" />
                            <Button x:Name="SevenDaysFilterButton" Text="7 kun" Clicked="SevenDaysFilterButton_Clicked" CornerRadius="14" Padding="14,9" />
                            <Button x:Name="MonthFilterButton" Text="Bu oy" Clicked="MonthFilterButton_Clicked" CornerRadius="14" Padding="14,9" />
                            <Button x:Name="YearFilterButton" Text="Bu yil" Clicked="YearFilterButton_Clicked" CornerRadius="14" Padding="14,9" />
                            <Button x:Name="CustomFilterButton" Text="Maxsus" Clicked="CustomFilterButton_Clicked" CornerRadius="14" Padding="14,9" />
                        </HorizontalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout x:Name="CustomDateLayout" IsVisible="False" Spacing="8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Boshlanish sanasi" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                                <DatePicker x:Name="StartDatePicker" Format="dd.MM.yyyy" TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Tugash sanasi" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                                <DatePicker x:Name="EndDatePicker" Format="dd.MM.yyyy" TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button
                            Text="Davrni qo'llash"
                            Clicked="ApplyCustomFilterButton_Clicked"
                            Style="{StaticResource PrimaryActionButton}"
                            CornerRadius="14" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </sh:MaterialFrame>

            <sh:MaterialFrame
                Padding="16"
                Style="{StaticResource GlassSurface}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="Haqiqiy natijalar"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                            <Label
                                x:Name="PeriodLabel"
                                Text="Bugun"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Text="Yangilash"
                            Clicked="RefreshButton_Clicked"
                            Style="{StaticResource PrimaryActionButton}"
                            CornerRadius="14"
                            Padding="12,8" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="Jami otlar" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                            <Label x:Name="HorseCountLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Jami tirik vazn" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                            <Label x:Name="TotalLiveWeightLabel" Text="0 kg" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1">
                            <Label Text="O'rtacha tirik vazn" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                            <Label x:Name="AverageLiveWeightLabel" Text="Ma'lumot yetarli emas" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Median / min / max" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                            <Label x:Name="LiveWeightRangeLabel" Text="Ma'lumot yetarli emas" FontSize="13" TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label
                        x:Name="LiveWeightDeviationLabel"
                        Text="Tirik vazn SD: Ma'lumot yetarli emas"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                </VerticalStackLayout>
            </sh:MaterialFrame>

            <VerticalStackLayout Spacing="10">
                <Label
                    Text="Mahsulotlar — real tarixiy taqsimot"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                <Label
                    x:Name="NoHistoricalDataLabel"
                    Text="Statistika uchun real ma'lumot kerak. Ma'lumot yetarli emas."
                    IsVisible="False"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding HistoricalMetrics}"
                    Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <sh:MaterialFrame
                                Padding="14"
                                Style="{StaticResource GlassSurface}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                                        <Label Grid.Column="1" Text="{Binding SampleCountText}" FontSize="11" TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
                                        <Label Text="{Binding AverageKgText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                        <Label Grid.Column="1" Text="{Binding AveragePercentText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                        <Label Grid.Row="1" Text="{Binding MedianKgText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding MedianPercentText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                        <Label Grid.Row="2" Text="{Binding MinimumKgText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding MinimumPercentText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                        <Label Grid.Row="3" Text="{Binding MaximumKgText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding MaximumPercentText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                        <Label Grid.Row="4" Text="{Binding StandardDeviationKgText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding StandardDeviationPercentText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </sh:MaterialFrame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <sh:MaterialFrame
                Padding="16"
                Style="{StaticResource GlassSurface}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Muayyan vazn tahlili"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                    <Label
                        Text="Quyidagi tarixiy tahlil maqsad vazndan 50 kg ichidagi real yozuvlarni ko'rib chiqadi."
                        FontSize="12"
                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry
                            x:Name="TargetWeightEntry"
                            Placeholder="Maqsad vazn (kg)"
                            Keyboard="Numeric"
                            FontSize="16"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                            PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#777777}" />
                        <Button
                            Grid.Column="1"
                            Text="Tahlil qilish"
                            Clicked="AnalyzeWeightButton_Clicked"
                            Style="{StaticResource PrimaryActionButton}"
                            CornerRadius="14"
                            Padding="14,9" />
                    </Grid>
                    <Label
                        x:Name="NearestWeightSummaryLabel"
                        Text="Maqsad vaznni kiriting."
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding NearestWeightMetrics}"
                        Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <sh:MaterialFrame
                                    Padding="14"
                                    Style="{StaticResource GlassSurface}">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                                            <Label Grid.Column="1" Text="{Binding SampleCountText}" FontSize="11" TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
                                            <Label Text="{Binding AverageKgText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                            <Label Grid.Column="1" Text="{Binding AveragePercentText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                            <Label Grid.Row="1" Text="{Binding MedianKgText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding MedianPercentText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                            <Label Grid.Row="2" Text="{Binding MinimumKgText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding MinimumPercentText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                            <Label Grid.Row="3" Text="{Binding MaximumKgText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding MaximumPercentText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                            <Label Grid.Row="4" Text="{Binding StandardDeviationKgText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding StandardDeviationPercentText}" FontSize="12" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </sh:MaterialFrame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </sh:MaterialFrame>

            <VerticalStackLayout Spacing="10">
                <Label
                    Text="Prognoz — alohida model natijasi"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                <Label
                    Text="Prognozlar real tarixiy natijalar emas. Ular mavjud yozuvlarga masofa bo'yicha og'irlik berib hisoblanadi."
                    FontSize="12"
                    TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                <Label
                    x:Name="PredictionAvailabilityLabel"
                    Text="Maqsad vaznni kiriting."
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding PredictionMetrics}"
                    Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <sh:MaterialFrame
                                Padding="14"
                                Style="{StaticResource GlassSurface}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                                        <Label Grid.Column="1" Text="{Binding ReliabilityText}" FontSize="11" TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                                    </Grid>
                                    <Label Text="{Binding PredictionText}" FontSize="13" TextColor="{AppThemeBinding Light=#374151, Dark=#DDDDDD}" />
                                    <Label Text="{Binding ConfidenceText}" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
                                </VerticalStackLayout>
                            </sh:MaterialFrame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label
                    Text="Qazi foizi yoki miqdori taxmin qilinmaydi; buning uchun qazi bo'yicha alohida real kuzatuvlar kerak."
                    FontSize="12"
                    TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
