<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="QaziCalculator.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QaziCalculator.Views"
    Title="Tarix"
    Background="{AppThemeBinding Light={StaticResource PageBackgroundLightBrush}, Dark={StaticResource PageBackgroundDarkBrush}}"
    xmlns:sh="clr-namespace:Sharpnado.MaterialFrame;assembly=Maui.MaterialFrame">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,Auto,*"
        RowSpacing="16">

        <views:PageNavigationBar />

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label
                Text="Tarix"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

            <Label
                Text="Saqlangan otlar va qayta ishlash natijalari"
                FontSize="14"
                TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
        </VerticalStackLayout>

        <SearchBar
            x:Name="HistorySearchBar"
            Grid.Row="2"
            Placeholder="Ot nomi bo'yicha qidirish"
            TextChanged="HistorySearchBar_TextChanged" />

        <sh:MaterialFrame
            Grid.Row="3"
            Padding="16"
            Style="{StaticResource GlassSurface}">

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label
                        x:Name="CountLabel"
                        Text="0 ta ot"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                    <Label
                        Text="Barcha saqlangan natijalar"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="Yangilash"
                    Clicked="RefreshButton_Clicked"
                    Style="{StaticResource PrimaryActionButton}"
                    CornerRadius="14"
                    Padding="16,10" />
            </Grid>
        </sh:MaterialFrame>

        <RefreshView
            Grid.Row="4"
            x:Name="HistoryRefreshView"
            Refreshing="HistoryRefreshView_Refreshing">

            <CollectionView
                x:Name="HistoryCollectionView"
                SelectionMode="Single"
                SelectionChanged="HistoryCollectionView_SelectionChanged">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        Spacing="10"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">

                        <Label
                            Text="Hali saqlangan otlar yo‘q"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                        <Label
                            Text="Birinchi qayta ishlash natijasini saqlang."
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <sh:MaterialFrame
                            Margin="0,0,0,12"
                            Padding="16"
                            Style="{StaticResource GlassSurface}">

                            <VerticalStackLayout Spacing="12">

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="3">
                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="19"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                                        <Label
                                            Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding LiveWeightKg, StringFormat='{0:N2} kg'}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                                        VerticalOptions="Center" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="*,*,*"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="8"
                                    RowSpacing="8">

                                    <sh:MaterialFrame
                                        Padding="10"
                                        BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#202024}">
                                        <VerticalStackLayout>
                                            <Label
                                                Text="Toza go‘sht"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                                            <Label
                                                Text="{Binding CleanMeatKg, StringFormat='{0:N2} kg'}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                                        </VerticalStackLayout>
                                    </sh:MaterialFrame>

                                    <sh:MaterialFrame
                                        Grid.Column="1"
                                        Padding="10"
                                        BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#202024}">
                                        <VerticalStackLayout>
                                            <Label
                                                Text="Yog‘"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                                            <Label
                                                Text="{Binding FatKg, StringFormat='{0:N2} kg'}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                                        </VerticalStackLayout>
                                    </sh:MaterialFrame>

                                    <sh:MaterialFrame
                                        Grid.Column="2"
                                        Padding="10"
                                        BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#202024}">
                                        <VerticalStackLayout>
                                            <Label
                                                Text="Suyak"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                                            <Label
                                                Text="{Binding BoneKg, StringFormat='{0:N2} kg'}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                                        </VerticalStackLayout>
                                    </sh:MaterialFrame>

                                    <sh:MaterialFrame
                                        Grid.Row="1"
                                        Padding="10"
                                        BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#202024}">
                                        <VerticalStackLayout>
                                            <Label
                                                Text="Pay"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                                            <Label
                                                Text="{Binding TendonKg, StringFormat='{0:N2} kg'}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                                        </VerticalStackLayout>
                                    </sh:MaterialFrame>

                                    <sh:MaterialFrame
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Padding="10"
                                        BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#202024}">
                                        <VerticalStackLayout>
                                            <Label
                                                Text="Kachalka"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                                            <Label
                                                Text="{Binding KachalkaKg, StringFormat='{0:N2} kg'}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                                        </VerticalStackLayout>
                                    </sh:MaterialFrame>

                                    <sh:MaterialFrame
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Padding="10"
                                        BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#202024}">
                                        <VerticalStackLayout>
                                            <Label
                                                Text="Chiqindi"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                                            <Label
                                                Text="{Binding WasteKg, StringFormat='{0:N2} kg'}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                                        </VerticalStackLayout>
                                    </sh:MaterialFrame>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="{Binding PurchasePricePerKg, StringFormat='Xarid: {0:N0} so‘m/kg'}"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding TotalPurchaseCost, StringFormat='{0:N0} so‘m'}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                                        VerticalOptions="Center" />
                                </Grid>

                            </VerticalStackLayout>
                        </sh:MaterialFrame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
