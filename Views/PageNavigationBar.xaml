<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="QaziCalculator.Views.PageNavigationBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sh="clr-namespace:Sharpnado.MaterialFrame;assembly=Maui.MaterialFrame">
    <sh:MaterialFrame Style="{StaticResource GlassSurface}" Padding="5">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button
                Text="Bosh sahifa"
                Clicked="HomeButton_Clicked"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light=#8B1E2D, Dark=#F0AAB2}"
                FontAttributes="Bold"
                FontSize="13"
                CornerRadius="16"
                Padding="6,8" />
            <Button
                x:Name="ThemeToggleButton"
                Grid.Column="1"
                Text="Tungi rejim"
                Clicked="ThemeToggleButton_Clicked"
                Style="{StaticResource PrimaryActionButton}"
                FontSize="13"
                CornerRadius="16"
                Padding="6,8" />
        </Grid>
    </sh:MaterialFrame>
</ContentView>
