<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="QaziCalculator.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QaziCalculator.Views"
    Title="Bosh sahifa"
    Background="{AppThemeBinding Light={StaticResource PageBackgroundLightBrush}, Dark={StaticResource PageBackgroundDarkBrush}}"
    xmlns:sh="clr-namespace:Sharpnado.MaterialFrame;assembly=Maui.MaterialFrame">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="18">
            <views:PageNavigationBar />
            <VerticalStackLayout Spacing="4">
                <Label Text="Adenalin Calculator" Style="{StaticResource PageTitle}" />
                <Label Text="Ishlab chiqarish nazorati" Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>

            <sh:MaterialFrame Style="{StaticResource GlassSurface}" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Bugungi ishlab chiqarish" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="14">
                        <VerticalStackLayout>
                            <Label Text="Bugungi otlar" Style="{StaticResource SecondaryText}" />
                            <Label x:Name="TodayHorsesLabel" Text="0" FontSize="30" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Tirik vazn" Style="{StaticResource SecondaryText}" />
                            <Label x:Name="TodayWeightLabel" Text="0 kg" FontSize="22" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1">
                            <Label Text="Real o'lchangan mahsulot" Style="{StaticResource SecondaryText}" />
                            <Label x:Name="TodayProductionLabel" Text="0 kg" FontSize="22" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Prognoz" Style="{StaticResource SecondaryText}" />
                            <Label Text="Haqiqiy ishlab chiqarishga kiritilmaydi" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </sh:MaterialFrame>

            <VerticalStackLayout Spacing="10">
                <Label Text="Tezkor amallar" Style="{StaticResource SectionTitle}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Button Text="+ Yangi ot" Clicked="NewHorseButton_Clicked" Style="{StaticResource PrimaryActionButton}" />
                    <Button Grid.Column="1" Text="Tarix" Clicked="HistoryButton_Clicked" />
                    <Button Grid.Row="1" Text="Statistika" Clicked="StatisticsButton_Clicked" />
                    <Button Grid.Row="1" Grid.Column="1" Text="Xarajat" Clicked="ExpenseButton_Clicked" />
                </Grid>
            </VerticalStackLayout>

            <sh:MaterialFrame Style="{StaticResource AppCard}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="So'nggi qaydlar" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Text="Barchasi" Clicked="HistoryButton_Clicked" Padding="12,6" />
                    </Grid>
                    <Label
                        x:Name="RecentEmptyLabel"
                        Text="Hali ma'lumot yo'q. Birinchi real qayta ishlash natijasini saqlang."
                        IsVisible="False"
                        Style="{StaticResource SecondaryText}" />
                    <VerticalStackLayout x:Name="RecentBatchesLayout" Spacing="8" />
                </VerticalStackLayout>
            </sh:MaterialFrame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
