<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="QaziCalculator.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QaziCalculator.Views"
    Title="Adenalin Calculator"
    Background="{AppThemeBinding Light={StaticResource PageBackgroundLightBrush}, Dark={StaticResource PageBackgroundDarkBrush}}"
    xmlns:sh="clr-namespace:Sharpnado.MaterialFrame;assembly=Maui.MaterialFrame">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <views:PageNavigationBar />

            <!-- HEADER -->
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Adenalin Calculator"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                <Label
                    Text="Real ishlab chiqarish natijalari va tahlil"
                    FontSize="15"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
            </VerticalStackLayout>

            <!-- OT MA'LUMOTLARI -->
            <sh:MaterialFrame
                Style="{StaticResource GlassSurface}"
                Padding="20">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Ot ma’lumotlari"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Ot nomi / raqami"
                            FontSize="14"
                            TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />

                        <Entry
                            x:Name="HorseNameEntry"
                            Placeholder="Masalan: Ot-001"
                            FontSize="17"
                            BackgroundColor="Transparent" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Tirik vazni"
                            FontSize="14"
                            TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="LiveWeightEntry"
                                Grid.Column="0"
                                Placeholder="Masalan: 420"
                                Keyboard="Numeric"
                                FontSize="18"
                                BackgroundColor="Transparent" />

                            <Label
                                Grid.Column="1"
                                Text="kg"
                                VerticalOptions="Center"
                                FontSize="16" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="1 kg xarid narxi"
                            FontSize="14"
                            TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="PurchasePriceEntry"
                                Grid.Column="0"
                                Placeholder="Masalan: 105000"
                                Keyboard="Numeric"
                                FontSize="18"
                                BackgroundColor="Transparent" />

                            <Label
                                Grid.Column="1"
                                Text="so‘m"
                                VerticalOptions="Center"
                                FontSize="16" />
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </sh:MaterialFrame>

            <!-- REAL QAYTA ISHLASH NATIJALARI -->
            <sh:MaterialFrame
                Style="{StaticResource GlassSurface}"
                Padding="20">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Qayta ishlash natijalari"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Label
                        Text="Faqat real o‘lchangan natijalarni kiriting. Qazi miqdori taxmin qilinmaydi; qazi tarkibi alohida real kuzatuvlardan o‘rganiladi."
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#999999}" />

                    <!-- TOZA GO'SHT -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="Toza go‘sht"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="CleanMeatEntry"
                                Grid.Column="0"
                                Placeholder="0"
                                Keyboard="Numeric"
                                FontSize="17"
                                BackgroundColor="Transparent" />

                            <Label
                                Grid.Column="1"
                                Text="kg"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- YOG' -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="Yog‘"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="FatEntry"
                                Grid.Column="0"
                                Placeholder="0"
                                Keyboard="Numeric"
                                FontSize="17"
                                BackgroundColor="Transparent" />

                            <Label
                                Grid.Column="1"
                                Text="kg"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- SUYAK -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="Suyak"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="BoneEntry"
                                Grid.Column="0"
                                Placeholder="0"
                                Keyboard="Numeric"
                                FontSize="17"
                                BackgroundColor="Transparent" />

                            <Label
                                Grid.Column="1"
                                Text="kg"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- PAY -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="Pay"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="TendonEntry"
                                Grid.Column="0"
                                Placeholder="0"
                                Keyboard="Numeric"
                                FontSize="17"
                                BackgroundColor="Transparent" />

                            <Label
                                Grid.Column="1"
                                Text="kg"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- KACHALKA -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="Kachalka"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="KachalkaEntry"
                                Grid.Column="0"
                                Placeholder="0"
                                Keyboard="Numeric"
                                FontSize="17"
                                BackgroundColor="Transparent" />

                            <Label
                                Grid.Column="1"
                                Text="kg"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- TARASH -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="Tarash"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="TarashEntry"
                                Grid.Column="0"
                                Placeholder="0"
                                Keyboard="Numeric"
                                FontSize="17"
                                BackgroundColor="Transparent" />

                            <Label
                                Grid.Column="1"
                                Text="kg"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- CHIQINDI -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="Chiqindi"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="WasteEntry"
                                Grid.Column="0"
                                Placeholder="0"
                                Keyboard="Numeric"
                                FontSize="17"
                                BackgroundColor="Transparent" />

                            <Label
                                Grid.Column="1"
                                Text="kg"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </sh:MaterialFrame>

            <!-- IZOH -->
            <sh:MaterialFrame
                Style="{StaticResource GlassSurface}"
                Padding="20">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Izoh"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Editor
                        x:Name="NotesEditor"
                        Placeholder="Ot turi, sana yoki boshqa qaydlar..."
                        AutoSize="TextChanges"
                        MinimumHeightRequest="90"
                        FontSize="15" />

                </VerticalStackLayout>
            </sh:MaterialFrame>

            <!-- HISOBLASH -->
            <Button
                x:Name="CalculateButton"
                Text="Hisoblash"
                Clicked="CalculateButton_Clicked"
                HeightRequest="56"
                CornerRadius="18"
                FontSize="17"
                FontAttributes="Bold"
                BackgroundColor="{AppThemeBinding Light=#8B1E2D, Dark=#C45A68}"
                TextColor="White" />

            <!-- NATIJA -->
            <sh:MaterialFrame
                x:Name="ResultCard"
                IsVisible="False"
                Style="{StaticResource GlassSurface}"
                Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Real o'lchovlar"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        RowSpacing="9">

                        <Label Text="Ot vazni" Grid.Row="0" />
                        <Label
                            x:Name="WeightResultLabel"
                            Text="0 kg"
                            Grid.Row="0"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Xarid qiymati" Grid.Row="1" />
                        <Label
                            x:Name="PurchaseCostResultLabel"
                            Text="0 so‘m"
                            Grid.Row="1"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Toza go‘sht" Grid.Row="2" />
                        <Label
                            x:Name="CleanMeatResultLabel"
                            Text="0 kg / 0%"
                            Grid.Row="2"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Yog‘" Grid.Row="3" />
                        <Label
                            x:Name="FatResultLabel"
                            Text="0 kg / 0%"
                            Grid.Row="3"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Suyak" Grid.Row="4" />
                        <Label
                            x:Name="BoneResultLabel"
                            Text="0 kg / 0%"
                            Grid.Row="4"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Pay" Grid.Row="5" />
                        <Label
                            x:Name="TendonResultLabel"
                            Text="0 kg / 0%"
                            Grid.Row="5"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Kachalka" Grid.Row="6" />
                        <Label
                            x:Name="KachalkaResultLabel"
                            Text="0 kg / 0%"
                            Grid.Row="6"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Tarash" Grid.Row="7" />
                        <Label
                            x:Name="TarashResultLabel"
                            Text="0 kg / 0%"
                            Grid.Row="7"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Chiqindi" Grid.Row="8" />
                        <Label
                            x:Name="WasteResultLabel"
                            Text="0 kg / 0%"
                            Grid.Row="8"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Jami qayd etilgan" Grid.Row="9" />
                        <Label
                            x:Name="TotalOutputResultLabel"
                            Text="0 kg"
                            Grid.Row="9"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Hisobga olinmagan" Grid.Row="10" />
                        <Label
                            x:Name="UnaccountedResultLabel"
                            Text="0 kg"
                            Grid.Row="10"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                        <Label Text="Qazi tarkibi (1 kg uchun)" Grid.Row="11" />
                        <Label
                            x:Name="QaziResultLabel"
                            Text="Prognoz uchun ma’lumot kerak"
                            Grid.Row="11"
                            Grid.Column="1"
                            FontAttributes="Bold" />

                    </Grid>

                    <Label
                        x:Name="QaziInfoLabel"
                        Text="Qazi miqdori taxmin qilinmaydi. Tarkib prognozi faqat real qazi yozuvlariga asoslanadi."
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#777777, Dark=#999999}" />

                </VerticalStackLayout>
            </sh:MaterialFrame>

            <sh:MaterialFrame
                x:Name="PredictionCard"
                IsVisible="False"
                Style="{StaticResource GlassSurface}"
                Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="PROGNOZ · REAL TARIX ASOSIDA"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#8B1E2D, Dark=#F0AAB2}" />
                    <Label
                        x:Name="PredictionSummaryLabel"
                        Text="Prognoz uchun ma'lumot yetarli emas."
                        FontSize="13"
                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="Toza go'sht" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                            <Label x:Name="PredictedCleanMeatLabel" Text="Ma'lumot yetarli emas" FontSize="13" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Yog'" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                            <Label x:Name="PredictedFatLabel" Text="Ma'lumot yetarli emas" FontSize="13" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1">
                            <Label Text="Suyak" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                            <Label x:Name="PredictedBoneLabel" Text="Ma'lumot yetarli emas" FontSize="13" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Pay" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                            <Label x:Name="PredictedTendonLabel" Text="Ma'lumot yetarli emas" FontSize="13" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2">
                            <Label Text="Kachalka" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                            <Label x:Name="PredictedKachalkaLabel" Text="Ma'lumot yetarli emas" FontSize="13" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                            <Label Text="Tarash" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                            <Label x:Name="PredictedTarashLabel" Text="Ma'lumot yetarli emas" FontSize="13" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="3">
                            <Label Text="Chiqindi" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" />
                            <Label x:Name="PredictedWasteLabel" Text="Ma'lumot yetarli emas" FontSize="13" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </sh:MaterialFrame>

            <!-- SAQLASH -->
            <Button
                x:Name="SaveButton"
                Text="Natijani saqlash"
                Clicked="SaveButton_Clicked"
                HeightRequest="56"
                CornerRadius="18"
                FontSize="17"
                FontAttributes="Bold"
                BackgroundColor="{AppThemeBinding Light=#F3E7E9, Dark=#34191D}"
                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
